<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de la pantalla de inicio: récord, esquinas en total, los 3 trofeos y un botón para abrir / cerrar el DVD.
     Al tocar el resto del widget se abre la app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_fondo"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DVD Rebote"
            android:textColor="#FF00BFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Récord: 0 esquinas"
            android:textColor="#FFFFD25A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="En total: 0"
            android:textColor="#FF9696A5"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <ImageView android:id="@+id/widget_bronce" android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/trofeo_bronce" />
            <ImageView android:id="@+id/widget_plata" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="4dp" android:src="@drawable/trofeo_plata" />
            <ImageView android:id="@+id/widget_oro" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="4dp" android:src="@drawable/trofeo_oro" />
            <ImageView android:id="@+id/widget_diamante" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="4dp" android:src="@drawable/trofeo_diamante" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_boton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/widget_boton"
        android:text="▶ Abrir DVD"
        android:textColor="#FFEBEBF0"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
