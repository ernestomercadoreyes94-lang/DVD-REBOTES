<?xml version="1.0" encoding="utf-8"?>
<!-- 4 x 1 casillas; se puede hacer más grande. Se actualiza solo cada 30 min y cuando se guardan las estadísticas. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="80dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_dvd"
    android:previewLayout="@layout/widget_dvd"
    android:widgetCategory="home_screen"
    android:description="@string/widget_descripcion" />
