@echo off
rem Cheat del DVD: STOP - cierra los DVDs
rem Funciona desde cualquier carpeta: se lo manda al DVD que este abierto.
title Cheat STOP
tasklist /fi "imagename eq DvdRebote.exe" 2>nul | find /i "DvdRebote.exe" >nul
if errorlevel 1 (
    echo.
    echo   Abre el DVD primero ^(DvdRebote.exe^).
    timeout /t 3 >nul
    exit /b 1
)
(echo STOP)>\\.\pipe\DvdRebote_Cheats 2>nul
if errorlevel 1 (
    echo.
    echo   No se pudo mandar el cheat. Prueba otra vez.
    timeout /t 3 >nul
    exit /b 1
)
echo.
echo   CHEAT STOP ACTIVADO: cierra los DVDs
timeout /t 1 >nul
